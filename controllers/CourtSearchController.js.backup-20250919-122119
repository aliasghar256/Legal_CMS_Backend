  // Helper function to remove duplicate hearings for a case
  static async removeDuplicateHearings(caseId) {
    try {
      console.log(`🔍 Checking for duplicate hearings in case ID: ${caseId}`);
      
      // Get all hearings for this case
      const existingHearingsResult = await query(
        'SELECT hearing_id, date, description FROM hearings WHERE case_id = $1 ORDER BY date DESC, hearing_id ASC',
        [caseId]
      );
      const existingHearings = existingHearingsResult.rows;
      
      if (existingHearings.length === 0) {
        console.log(`No hearings found for case ${caseId}`);
        return { duplicatesRemoved: [], message: 'No hearings found' };
      }

      // Group hearings by date to detect duplicates
      const hearingsByDate = new Map();
      const duplicatesRemoved = [];
      
      existingHearings.forEach(hearing => {
        const dateKey = hearing.date;
        
        if (!hearingsByDate.has(dateKey)) {
          hearingsByDate.set(dateKey, []);
        }
        hearingsByDate.get(dateKey).push(hearing);
      });

      // Process each date group
      for (const [date, hearingGroup] of hearingsByDate) {
        if (hearingGroup.length > 1) {
          console.log(`🚨 Found ${hearingGroup.length} duplicate hearings for date: ${date}`);
          
          // Sort by: 1) has content first, 2) then by hearing_id (first created)
          hearingGroup.sort((a, b) => {
            const aHasContent = a.description && a.description.trim() !== '';
            const bHasContent = b.description && b.description.trim() !== '';
            
            // Prioritize hearings with content
            if (aHasContent && !bHasContent) return -1;
            if (!aHasContent && bHasContent) return 1;
            
            // If both have content or both are blank, keep the first created (lower ID)
            return a.hearing_id - b.hearing_id;
          });
          
          // Keep the first (best) hearing, delete the rest
          const keepHearing = hearingGroup[0];
          const duplicatesToDelete = hearingGroup.slice(1);
          
          console.log(`📌 Keeping hearing ID ${keepHearing.hearing_id} (${keepHearing.description ? 'has content' : 'blank'})`);
          
          for (const duplicate of duplicatesToDelete) {
            try {
              await query('DELETE FROM hearings WHERE hearing_id = $1', [duplicate.hearing_id]);
              
              duplicatesRemoved.push({
                hearing_id: duplicate.hearing_id,
                date: duplicate.date,
                description: duplicate.description,
                reason: `Duplicate of hearing ID ${keepHearing.hearing_id}`
              });
              
              console.log(`🗑️ Deleted duplicate hearing ID ${duplicate.hearing_id} on ${duplicate.date}`);
            } catch (error) {
              console.error(`Error deleting duplicate hearing ${duplicate.hearing_id}:`, error);
            }
          }
        }
      }

      const message = duplicatesRemoved.length > 0 
        ? `Removed ${duplicatesRemoved.length} duplicate hearing(s)`
        : 'No duplicates found';
      
      console.log(`✅ Duplicate removal completed for case ${caseId}: ${message}`);
      
      return {
        duplicatesRemoved: duplicatesRemoved,
        message: message,
        totalDuplicatesRemoved: duplicatesRemoved.length
      };
      
    } catch (error) {
      console.error(`Error removing duplicates for case ${caseId}:`, error);
      throw error;
    }
  }

