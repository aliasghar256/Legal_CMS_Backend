# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=legal_cms

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# Server Configuration
PORT=3001
NODE_ENV=development

# Email Service Configuration (Resend)
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=your_email@yourdomain.com

# WhatsApp Service Configuration
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# WhatsApp Development Mode (set to 'true' for simulation)
WHATSAPP_SIMULATION_MODE=true

# Reminder Scheduler Configuration
REMINDER_CRON_PATTERN=*/5 * * * *
REMINDER_TIMEZONE=America/New_York
REMINDER_RUN_ON_START=true
REMINDER_AUTO_START=true

# Optional: Advanced Scheduler Settings
# REMINDER_CLEANUP_CRON=0 2 * * *
# REMINDER_STATS_CRON=0 9 * * MON
# REMINDER_MAX_RETRIES=3
# REMINDER_RETRY_INTERVAL_MINUTES=30
